---
import Base from '../layouts/Base.astro';
---

<Base titre="MORDU — Mon profil" actuel="profil" statut={true}>
  <h2 id="h"></h2>
  <p class="hint" id="intro"></p>
  <div id="vue"></div>

</Base>

<script>
  import { API, GET, POST, esc, img } from '../lib/api.js';
  const MORDU = (window as any).MORDU;

const st=document.getElementById("status"), vue=document.getElementById("vue");

function barres(items, cle, val){
  const max=Math.max(...items.map(i=>i[val]),1);
  return items.map(i=>`<div class="barre">
    <div class="t"><span>${esc(i[cle])}</span><span>${typeof i[val]==="number"?i[val].toFixed?i[val].toFixed(0):i[val]:""}</span></div>
    <div class="j"><i style="width:${Math.round(100*i[val]/max)}%"></i></div></div>`).join("");
}

(async()=>{
  let p, ars;
  try{
    // EN PARALLÈLE. Ces deux appels ne dépendent pas l'un de l'autre ; en série ils
    // additionnaient leurs latences pour rien. Mesuré sur le profil : 491 ms d'écran vide
    // entre le HTML prêt et le dernier appel terminé.
    [p, ars] = await Promise.all([GET("/api/profil"), GET("/api/aretes")]);
    st.className="status ok"; st.textContent=`${p.films} films connus · ${p.aretes} arête${p.aretes>1?"s":""}`;
  }catch(e){
    st.className="status ko"; st.textContent="API hors ligne";
    vue.innerHTML=`<div class="banner"><b>API injoignable</b>. Lance
      <code>uvicorn main:app --reload</code> depuis <code>backend/</code>.</div>`;
    return;
  }
  MORDU.resoudreTexte(document.getElementById("h"),"Ce que je sais de toi",{duree:800});

  // Honnêteté d'abord : avec peu d'arêtes, on le DIT au lieu d'inventer un portrait.
  document.getElementById("intro").innerHTML = p.fiable
    ? `Tout ceci est <b>recalculé</b> depuis ce que tu as vu et écrit — rien n'est stocké.
       Si tu changes d'avis en racontant un film, le portrait change avec toi.`
    : `⚠︎ <b>Portrait encore mince</b> : ${p.aretes} ressenti${p.aretes>1?"s":""} seulement.
       Ce que tu lis vient surtout de tes films de départ, pas encore de ce que tu écris.
       Il faut environ <b>cinq</b> ressentis pour que ça dise vraiment quelque chose —
       et je préfère te le dire que te fabriquer un profil qui sonne juste sans l'être.`;

  const nuage = p.motifs.length
    ? `<div class="nuage">${p.motifs.map((m,i)=>`<span class="${i<3?'fort':''}">${esc(m.nom)}</span>`).join("")}</div>`
    : `<p class="vide">Pas encore assez de films pour dégager des motifs.</p>`;

  const vocab = p.vocabulaire.length
    ? `<div class="nuage">${p.vocabulaire.map((v,i)=>`<span class="${i<3?'fort':''}">${esc(v.mot)}</span>`).join("")}</div>
       <p class="vide" style="margin-top:10px">Ce que tu <b>mentionnes</b> est ton goût autant que
       ce que tu aimes : deux personnes adorent le même film pour des raisons opposées.</p>`
    : `<p class="vide">Tu n'as encore rien écrit. C'est pourtant là que se trouve
       ce que personne d'autre ne peut deviner de toi.</p>`;

  vue.innerHTML=`
    <div id="muet"></div>
    <h2 id="hc" style="margin-top:4px"></h2>
    <p class="hint">Les 6000 films projetés depuis <b>384 dimensions</b> vers un plan
    (PaCMAP), puis regroupés par densité. Les territoires se nomment eux-mêmes : on garde
    les motifs <b>sur-représentés</b> dans chaque zone, pas les plus fréquents — « drame »
    ne dit rien, « huis clos » nomme.</p>
    <div class="portrait apparait" id="portrait"></div>
    <div class="carte">
      <canvas id="cv" width="1180" height="620"></canvas>
      <div class="tip" id="tip"></div>
      <div class="fiche" id="fiche"></div>
      <div class="lg">
        <span><i style="background:#E4130F"></i><b>tes films</b></span>
        <span><i style="background:#D0B278"></i>proches de toi</span>
        <span><i style="background:#34465C"></i>le reste du territoire</span>
        <span><i style="background:#3FA45A"></i>ton centre de gravité</span>
      </div>
    </div>
    <div class="terrs" id="terrs"></div>

    <h2 style="margin-top:30px" id="hd"></h2>
    <div class="grille">
      <div class="bloc apparait"><div class="lbl">Tes motifs</div>${nuage}</div>
      <div class="bloc apparait"><div class="lbl">Tes genres</div>${barres(p.genres,"nom","n")}</div>
      <div class="bloc apparait"><div class="lbl">Les mots que tu emploies</div>${vocab}</div>
      <div class="bloc apparait"><div class="lbl">Signatures</div>
        <div class="liste">
          ${p.realisateurs.map(r=>`<div>${esc(r.nom)}<span class="n">${r.n}</span></div>`).join("")||'<span class="vide">—</span>'}
        </div>
        <div class="lbl" style="margin-top:14px">Visages</div>
        <div class="liste">
          ${p.acteurs.slice(0,4).map(a=>`<div>${esc(a.nom)}<span class="n">${a.n}</span></div>`).join("")||'<span class="vide">—</span>'}
        </div>
      </div>
      <div class="bloc apparait"><div class="lbl">Ta forme</div>
        <div class="liste">
          <div>Durée moyenne <span class="n">${p.duree_moyenne??"—"} min</span></div>
          <div>Époque moyenne <span class="n">${p.annee_moyenne??"—"}</span></div>
        </div>
        <div class="lbl" style="margin-top:14px">L'oracle te connaît</div>
        ${/* PAS DE SCORE. Le produit affichait « 10/10 » sur UN pari jugé — sous
              l'hypothèse nulle d'une pièce, p = 0,50 : ça ne veut rigoureusement rien
              dire. Et l'élément s'appelait « jauge », que le §8 du manifeste enterre.
              On compte, on ne note pas. Un taux ne reviendra qu'au-delà de 20 paris,
              et avec son intervalle. */""}
        ${p.palmares && p.palmares.juges
          ? `<p class="vide">L'oracle a scellé <b>${p.palmares.paris}</b> pari${p.palmares.paris>1?"s":""},
             tu en as jugé <b>${p.palmares.juges}</b>.
             ${p.palmares.juges < 20
               ? `Trop peu pour en tirer un taux — sur ${p.palmares.juges},
                  même une pièce ferait aussi bien assez souvent pour qu'un chiffre mente.`
               : ""}</p>`
          : `<p class="vide">Aucun pari jugé pour l'instant. C'est <b>lui</b> qui est noté,
             jamais toi — tu ne peux pas échouer ici.</p>`}
      </div>
      <div class="bloc apparait"><div class="lbl">Ce vers quoi tu penches</div>
        <p class="vide" style="margin-bottom:9px">Les films du catalogue les plus proches de
        ton vecteur. Ce ne sont pas des recommandations — l'oracle, lui, arbitre aussi
        l'orthogonalité et ton envie du soir.</p>
        <div class="voisins" id="vois"></div>
      </div>
    </div>
    <h2 style="margin-top:30px" id="h2a"></h2>
    <div id="ars"></div>`;
  MORDU.resoudreTexte(document.getElementById("h2a"),"Tes ressentis",{duree:700});

  // ---- COMPLÉTER LES FILMS DE DÉPART MUETS ----
  // Une graine sans texte ne porte ni vocabulaire ni axe d'attention : elle ne pèse
  // que par son vecteur. La compléter AJOUTE une arête — rien n'est réécrit.
  try{
    const muets=await GET("/api/graines_muettes");
    if(muets.length){
      const MIN=15, el=document.getElementById("muet");
      el.className="muet";
      el.innerHTML=`<div class="lbl">Tes films de départ n'ont pas de description</div>
        <p class="vide" style="margin:0">Ces ${muets.length} films ne pèsent que par leur
        vecteur : ils n'apportent ni ton vocabulaire ni tes axes d'attention. Les décrire
        <b>ajoute</b> une arête — rien n'est effacé.</p>
        ${muets.map((m,i)=>`<div class="f" data-i="${i}"><canvas></canvas><div class="z">
          <div class="t">${esc(m.titre)}</div>
          <textarea placeholder="ce qui t'a marqué dans ce film…"></textarea>
          <div class="cpt"></div></div></div>`).join("")}
        <button class="btn" id="envm" disabled>Enregistrer →</button>`;
      const b=document.getElementById("envm");
      const etat=muets.map(()=>"");
      el.querySelectorAll(".f").forEach((f,i)=>{
        const m=muets[i], cv=f.querySelector("canvas"), im=img(m.poster_path);
        const go=()=>MORDU.tramer(cv,im,{net:1,temperature:MORDU.temperature(m),w:64,h:96});
        if(im&&!im.complete) im.addEventListener("load",go,{once:true}); go();
        const ta=f.querySelector("textarea"), cp=f.querySelector(".cpt");
        if(MORDU.dicteeDispo){
          const b=document.createElement("button");
          b.className="btn micro"; b.textContent="dicter";
          ta.parentNode.insertBefore(b, ta.nextSibling);
          MORDU.dicter(ta, b);
        }
        ta.addEventListener("input",()=>{
          etat[i]=ta.value; const n=ta.value.trim().length;
          cp.textContent = n>=MIN ? "✓" : (n?`${n}/${MIN} caractères minimum`:"");
          b.disabled = !etat.some(t=>t.trim().length>=MIN);
        });
      });
      b.addEventListener("click",async()=>{
        b.disabled=true; b.textContent="…";
        // ON NE RECHARGE QUE SI ÇA A MARCHÉ. Avant : `fetch` écrit à la main sans vérifier
        // r.ok, puis `location.reload()` inconditionnel. Sur une réponse non-2xx, les
        // descriptions que tu venais d'écrire partaient à la poubelle SANS UN MOT — la
        // seule perte de saisie réellement destructrice du produit.
        // (Et POST était importé ici sans être appelé une seule fois.)
        const echecs=[];
        for(let i=0;i<muets.length;i++){
          const t=(etat[i]||"").trim();
          if(t.length<MIN) continue;
          try{
            await POST("/api/ressenti",{film_id:muets[i].film_id,texte:t,
                                        titre:muets[i].titre,registre:"onboarding"});
          }catch(e){ console.error("[graine muette]",muets[i].titre,e); echecs.push(muets[i].titre); }
        }
        if(echecs.length){
          b.disabled=false; b.textContent="Réessayer →";
          const av=document.createElement("p");
          av.className="vide"; av.style.color="var(--red)";
          av.textContent=`Échec sur ${echecs.join(", ")} — tes textes sont intacts ci-dessus.`;
          b.parentNode.insertBefore(av,b.nextSibling);
          return;
        }
        location.reload();
      });
    }
  }catch(e){}

  // ---- LE PORTRAIT (ce qui se LIT) ----
  // MANIFESTE §4 : « ce que tu MENTIONNES est ton axe d'attention ». L'empreinte est
  // unique et déterministe mais muette ; ceci est la moitié qui parle. Le signal le
  // plus fort n'est pas ce dont on parle le plus, c'est ce dont on ne parle JAMAIS.
  if(p.portrait){
    const P=p.portrait, el=document.getElementById("portrait");
    if(!P.aretes){
      el.innerHTML=`<div class="lbl">Ton portrait</div>
        <div class="p" style="font-size:15px;color:var(--mut)">Tu n'as encore rien écrit.
        Ce portrait se construit sur <b>ce que tu mentionnes</b> quand tu racontes un film —
        pas sur les films eux-mêmes.</div>`;
    } else {
      el.innerHTML=`<div class="lbl">Ton portrait${P.fiable?"":" — encore fragile"}</div>
        <div class="p">${esc(P.phrase)}</div>
        ${P.fiable?"":`<div class="vide" style="margin-top:9px">Sur ${P.aretes} ressenti${P.aretes>1?"s":""} seulement —
          il en faut environ quatre pour que ces axes veuillent dire quelque chose.</div>`}
        <div class="ax">${P.axes.map(a=>`<div class="a ${a.n?'on':''}">
          <div class="n">${esc(a.libelle)}</div>
          <div class="m">${a.n?`${a.n} mention${a.n>1?"s":""} · ${a.mots.slice(0,3).map(esc).join(", ")}`:"jamais mentionné"}</div>
        </div>`).join("")}</div>`;
    }
  }

  // ---- L'EMPREINTE ----
  // Ton goût EST déjà un objet mathématique unique : plutôt que de le résumer en
  // barres, on le montre tel quel — le vecteur replié en grille et quantifié sur la
  // palette. Déterministe, et il SE RÉSOUT à mesure que tu écris : c'est le même
  // principe que les affiches, appliqué à toi.
  // ---- LA CARTE ----
  MORDU.resoudreTexte(document.getElementById("hc"),"La carte de ton goût",{duree:800});
  MORDU.resoudreTexte(document.getElementById("hd"),"Le détail",{duree:700,retard:200});
  let C=null;
  try{ C=await GET("/api/carte"); }catch(e){}
  if(C){
    const cv=document.getElementById("cv"), ctx=cv.getContext("2d");
    const W=cv.width, H=cv.height, PAD=54, CELL=5;
    const px=p=>PAD+p.x*(W-2*PAD), py=p=>PAD+(1-p.y)*(H-2*PAD);
    // aligner sur une grille : c'est ce qui donne la matière « tramée » plutôt qu'un
    // nuage de ronds lisses — la carte appartient au même monde que les affiches
    const snap=v=>Math.round(v/CELL)*CELL;

    function dessiner(surbrillance){
      ctx.fillStyle="#07080A"; ctx.fillRect(0,0,W,H);
      // 1. le territoire, en fond : une nappe de densité tramée
      const occ=new Map();
      C.points.forEach(p=>{
        const x=snap(px(p)), y=snap(py(p)), c=`${x},${y}`;
        occ.set(c,(occ.get(c)||0)+1);
      });
      occ.forEach((n,c)=>{
        const [x,y]=c.split(",").map(Number);
        const t=Math.min(1,n/3);
        ctx.fillStyle=t>.66?"#2C3A4E":t>.33?"#222D3C":"#18202B";
        ctx.fillRect(x,y,CELL-1,CELL-1);
      });
      // 1bis. BROUILLARD : les territoires où tu n'as jamais mis les pieds restent
      //       dans la nuit. Ce qui reste éclairé, c'est ce que tu as parcouru — la
      //       carte raconte alors ton exploration, pas seulement le catalogue.
      const explores=new Set(C.territoires.filter(t=>t.tiens>0).map(t=>t.id));
      if(explores.size){
        C.points.filter(p=>p.z>=0 && !explores.has(p.z)).forEach(p=>{
          ctx.fillStyle="rgba(7,8,10,.55)";
          ctx.fillRect(snap(px(p))-1,snap(py(p))-1,CELL+1,CELL+1);
        });
      }

      // 2. les proches, puis les tiens : l'ordre compte, tes films au-dessus de tout
      C.points.filter(p=>p.k===1).forEach(p=>{
        ctx.fillStyle="#D0B278"; ctx.fillRect(snap(px(p)),snap(py(p)),CELL-1,CELL-1); });
      C.points.filter(p=>p.k===2).forEach(p=>{
        const x=snap(px(p)),y=snap(py(p));
        ctx.fillStyle="#E4130F"; ctx.fillRect(x-CELL,y-CELL,CELL*3-1,CELL*3-1);
        ctx.fillStyle="#F5EFE3"; ctx.fillRect(x,y,CELL-1,CELL-1);
      });
      // 3. ton centre de gravité : une croix, pas un rond — ça se repère
      if(C.centre){
        const x=snap(PAD+C.centre[0]*(W-2*PAD)), y=snap(PAD+(1-C.centre[1])*(H-2*PAD));
        ctx.fillStyle="#3FA45A";
        ctx.fillRect(x-CELL*4,y,CELL*9,CELL-1); ctx.fillRect(x,y-CELL*4,CELL-1,CELL*9);
      }
      // 4. les noms de territoires : lisibles, donc jamais tramés.
      //    Ils s'ÉVITENT (une étiquette qui en recouvre une autre les tue toutes les
      //    deux) et restent dans le cadre — au bord, la carte tronquait les noms.
      ctx.textAlign="center";
      const poses=[];
      // les tiens d'abord, puis les gros. On compare des NOMBRES : soustraire deux
      // booléens marche par coercition en JS mais ne se lit pas, et c'est le genre
      // d'astuce qui casse silencieusement le jour où l'un des deux devient undefined.
      const rang = t => (t.tiens > 0 ? 1 : 0);
      const ordre=[...C.territoires].sort((a,b)=> rang(b) - rang(a) || b.n - a.n);
      ordre.forEach(t=>{
        const mien=t.tiens>0, sur=surbrillance===t.id;
        ctx.font=`${mien?"600 ":""}12px ui-monospace,SF Mono,Menlo,monospace`;
        const txt=t.nom.length>34?t.nom.slice(0,33)+"…":t.nom;
        const w=ctx.measureText(txt).width, h=17;
        let x=PAD+t.x*(W-2*PAD), y=PAD+(1-t.y)*(H-2*PAD);
        x=Math.min(Math.max(x,w/2+8), W-w/2-8);          // jamais hors cadre
        y=Math.min(Math.max(y,h+4), H-26);
        // on décale verticalement tant que ça chevauche un nom déjà posé
        let dec=0, ok=false;
        for(let essai=0; essai<9 && !ok; essai++){
          dec = essai===0?0:(essai%2?1:-1)*Math.ceil(essai/2)*19;
          const yy=y+dec;
          ok = yy>h && yy<H-22 && !poses.some(r=>
            Math.abs(r.x-x)<(r.w+w)/2+8 && Math.abs(r.y-yy)<h+3);
        }
        if(!ok && !mien) return;                          // on préfère cacher que superposer
        y+=dec;
        poses.push({x,y,w});
        ctx.fillStyle="rgba(7,8,10,.86)"; ctx.fillRect(x-w/2-5,y-13,w+10,h);
        ctx.fillStyle=sur?"#fff":(mien?"#E4130F":"#8E8E86");
        ctx.fillText(txt,x,y);
      });
    }
    dessiner(null);

    // survol : retrouver le film le plus proche du curseur
    const tip=document.getElementById("tip");
    cv.addEventListener("mousemove",e=>{
      const r=cv.getBoundingClientRect(), sx=W/r.width, sy=H/r.height;
      const mx=(e.clientX-r.left)*sx, my=(e.clientY-r.top)*sy;
      let best=null,bd=1e9;
      for(const p of C.points){
        const d=(px(p)-mx)**2+(py(p)-my)**2;
        if(d<bd){bd=d;best=p;}
      }
      if(best && bd<900){
        tip.textContent=best.t; tip.classList.add("on");
        tip.style.left=((px(best)/sx))+"px"; tip.style.top=((py(best)/sy))+"px";
      } else tip.classList.remove("on");
    });
    cv.addEventListener("mouseleave",()=>tip.classList.remove("on"));

    // CLIQUER un point : la carte devient explorable, pas seulement contemplative.
    // C'est ce qui la fait passer d'une illustration à un instrument.
    const fiche=document.getElementById("fiche");
    cv.addEventListener("click",async e=>{
      const r=cv.getBoundingClientRect(), sx=W/r.width, sy=H/r.height;
      const mx=(e.clientX-r.left)*sx, my=(e.clientY-r.top)*sy;
      let best=null,bd=1e9;
      for(const q of C.points){ const d=(px(q)-mx)**2+(py(q)-my)**2; if(d<bd){bd=d;best=q;} }
      if(!best || bd>1600){ fiche.classList.remove("on"); return; }
      const terr=C.territoires.find(t=>t.id===best.z);
      let det=null;
      try{ det=(await GET(`/api/movies?search=${encodeURIComponent(best.t)}&limit=1`))[0]; }catch(_){}
      fiche.innerHTML=`<span class="x" id="fx">✕</span>
        ${det&&det.poster_path?`<canvas></canvas>`:``}
        <div class="t">${esc(best.t)}</div>
        <div class="m">${det&&det.year?det.year+" · ":""}${det&&det.genres?det.genres.join(", "):""}</div>
        <div class="m">${terr?"territoire : "+esc(terr.nom):"hors territoire (trop isolé)"}</div>
        ${best.k===2?`<div class="m" style="color:var(--red)">↳ un de tes films</div>`:
          best.k===1?`<div class="m" style="color:#D0B278">↳ proche de ton goût</div>`:``}`;
      fiche.classList.add("on");
      const fc=fiche.querySelector("canvas");
      if(fc && det && det.poster_path){
        const im=img(det.poster_path);
        const go=()=>MORDU.tramer(fc,im,{net:1,temperature:MORDU.temperature(det),
                                         w:200,h:300});
        if(!im.complete) im.addEventListener("load",go,{once:true});
        go();
      }
      fiche.querySelector("#fx").addEventListener("click",()=>fiche.classList.remove("on"));
    });

    document.getElementById("terrs").innerHTML=C.territoires.map(t=>
      `<div class="terr apparait ${t.tiens?'mien':''}" data-id="${t.id}">
        <div class="n">${esc(t.nom)}</div>
        <div class="m">${t.n} films${t.tiens?` · ${t.tiens} à toi`:""}${t.affinite!==undefined?` · affinité ${t.affinite.toFixed(2)}`:""}</div>
      </div>`).join("");
    document.querySelectorAll(".terr").forEach(el=>{
      el.addEventListener("mouseenter",()=>dessiner(+el.dataset.id));
      el.addEventListener("mouseleave",()=>dessiner(null));
    });
  }

  const vs=document.getElementById("vois");
  vs.innerHTML=p.voisins.map(v=>`<div class="v"><canvas></canvas>
    <div class="t">${esc(v.title)}</div><div class="a">${v.affinite.toFixed(2)}</div></div>`).join("");
  vs.querySelectorAll(".v").forEach((el,i)=>{
    const v=p.voisins[i], cv=el.querySelector("canvas"), im=img(v.poster_path);
    const go=()=>MORDU.tramer(cv,im,{net:1,temperature:MORDU.temperature(v),w:88,h:132});
    if(im&&!im.complete) im.addEventListener("load",go,{once:true});
    go();
  });

  document.getElementById("ars").innerHTML = ars.length
    ? ars.slice().reverse().map(a=>`<div class="arete">
        <div class="h">${esc(a.titre||"—")}</div>
        <div class="d">${(a.date||"").slice(0,10)} · ressenti ${a.valence>=0.55?"très positif":a.valence>=0.2?"positif":a.valence>=-0.2?"mitigé":"négatif"}${a.abandonne?" · abandonné":""}</div>
        <div class="x">${esc(a.texte)}</div></div>`).join("")
    : `<p class="vide">Aucun ressenti pour l'instant. Chaque film que tu racontes ajoute une
       arête — et c'est la seule matière que MORDU possède et que personne d'autre n'a.</p>`;
})();
</script>

<style is:global>
  /* is:global : ces écrans construisent l'essentiel de leur DOM à l'exécution via
     innerHTML. Les styles scopés d'Astro posent un attribut sur les éléments du TEMPLATE
     seulement — les éléments injectés ne l'auraient jamais, et la moitié des règles
     tomberait à côté. C'est le piège n°1 de cette migration. */

  .grille{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:16px;margin-top:6px}
  .bloc{border:1px solid var(--line);background:var(--panel);padding:16px 17px}
  .bloc .lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;
